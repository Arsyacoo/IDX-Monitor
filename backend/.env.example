# Backend runtime configuration
# Use comma-separated origins for production, e.g. https://idx-monitor.vercel.app
CORS_ORIGINS=*

# Price cache background worker
PRICE_BATCH_SIZE=50
PRICE_BATCH_DELAY_SECONDS=2
PRICE_REFRESH_INTERVAL_SECONDS=60

# Chart history cache
HISTORY_CACHE_TTL_SECONDS=600
YAHOO_CHART_URL=https://query1.finance.yahoo.com/v8/finance/chart/{ticker}

# External provider resilience
UNAVAILABLE_TICKER_TTL_SECONDS=3600
EXTERNAL_REQUEST_RETRIES=2
EXTERNAL_REQUEST_BACKOFF_SECONDS=1
